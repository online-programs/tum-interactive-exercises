<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Put the process steps in order</title>
<style>
:root { --tum-blue:#0065BD; --tum-orange:#E37222; --ink:#233142; --pale:#f4f8fc; }
* { box-sizing:border-box; }
body { margin:0; padding:18px; font-family:Arial,Helvetica,sans-serif; color:var(--ink); background:#fff; }
.wrap { max-width:900px; margin:0 auto; }
.instruction { text-align:center; padding:14px 12px; border:1px solid #aeb8c2; background:#f4f6f8; border-radius:6px; font-size:16px; margin-bottom:18px; }
h2 { font-size:17px; margin:18px 0 9px; }
.help { color:#536273; font-size:13px; margin:0 0 10px; }
.pool, .slots { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
.pool { padding:10px; background:#f4f8fc; border:1px solid #d5e0ea; border-radius:8px; }
.card { min-width:0; border:2px solid var(--tum-blue); background:#fff; border-radius:8px; padding:8px; cursor:grab; touch-action:none; user-select:none; box-shadow:0 1px 3px #00000014; }
.card:focus-visible, .slot:focus-visible, button:focus-visible { outline:3px solid var(--tum-orange); outline-offset:2px; }
.card.dragging { opacity:.45; }
.card img { display:block; width:100%; height:130px; object-fit:cover; border:1px solid #24313d; pointer-events:none; }
.card .tag { display:block; text-align:center; color:var(--tum-blue); font-weight:bold; font-size:12px; padding:2px 0 7px; }
.slots { margin-bottom:14px; }
.slot { min-height:170px; padding:8px; border:2px dashed #9aabba; border-radius:8px; background:#fbfcfe; display:flex; flex-direction:column; gap:7px; align-items:stretch; }
.slot.over { border-color:var(--tum-orange); background:#fff6ee; }
.slot-label { font-size:13px; font-weight:bold; color:#536273; text-align:center; }
.slot .card { flex:1; }
.slot .card img { height:112px; }
.placeholder { margin:auto; color:#8493a1; font-size:13px; text-align:center; }
.controls { display:flex; flex-wrap:wrap; gap:9px; align-items:center; }
button { border:0; border-radius:5px; padding:11px 17px; font-size:14px; font-weight:bold; cursor:pointer; }
.primary { background:var(--tum-blue); color:white; }
.secondary { background:#e9eef3; color:#233142; }
#feedback { min-height:24px; margin-top:12px; font-weight:bold; }
#feedback.good { color:#167044; }
#feedback.bad { color:#a33b20; }
@media(max-width:560px) {
 body { padding:12px; }
 .pool,.slots { gap:6px; }
 .pool { padding:6px; }
 .card { padding:5px; }
 .card img { height:92px; }
 .slot { min-height:130px; padding:5px; }
 .slot .card img { height:80px; }
 .slot-label { font-size:11px; }
 .instruction { font-size:14px; }
}
</style>
</head>
<body>
<div class="wrap">
  <div class="instruction">Drag the process steps from here and drop them in the correct order below.</div>
  <h2>Process steps</h2>
  <p class="help">Select and drag each image into one of the three positions. You can also use the arrow keys after selecting a card.</p>
  <div class="pool" id="pool" aria-label="Available process steps"></div>
  <h2>Put the steps in order</h2>
  <div class="slots" id="slots">
    <div class="slot" data-slot="0" tabindex="0" aria-label="Step 1 drop area"><div class="slot-label">Step 1</div><div class="placeholder">Drop an image here</div></div>
    <div class="slot" data-slot="1" tabindex="0" aria-label="Step 2 drop area"><div class="slot-label">Step 2</div><div class="placeholder">Drop an image here</div></div>
    <div class="slot" data-slot="2" tabindex="0" aria-label="Step 3 drop area"><div class="slot-label">Step 3</div><div class="placeholder">Drop an image here</div></div>
  </div>
  <div class="controls">
    <button class="primary" id="check">Check answer</button>
    <button class="secondary" id="reset">Try again</button>
  </div>
  <div id="feedback" role="status" aria-live="polite"></div>
</div>
<script>
const images = [
  "data:image/jpeg;base64,",
  "data:image/jpeg;base64,",
  "data:image/jpeg;base64,"
];
// The screenshot does not reveal the intended correct sequence.
// By default, the activity checks that all three images have been placed.
// Set this to an order such as [2,0,1] once the intended sequence is confirmed.
const correctOrder = null;

const pool = document.getElementById('pool');
const slots = [...document.querySelectorAll('.slot')];
const feedback = document.getElementById('feedback');
let selected = null;
let pointerCard = null;

function makeCard(index) {
  const card = document.createElement('div');
  card.className = 'card';
  card.dataset.index = String(index);
  card.tabIndex = 0;
  card.setAttribute('role','button');
  card.setAttribute('aria-label',`Process image ${index+1}. Select, then choose a position.`);
  card.innerHTML = `<span class="tag">Drag to order</span><img src="${images[index]}" alt="Process step image ${index+1}">`;
  card.addEventListener('click', () => { selected = card; feedback.textContent = `Image ${index+1} selected. Choose a step position.`; });
  card.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft' || e.key === 'Enter') {
      e.preventDefault(); selected = card;
      const current = slots.findIndex(s => s.contains(card));
      const target = e.key === 'ArrowLeft' ? Math.max(0, current < 0 ? 0 : current-1) :
                     e.key === 'ArrowRight' ? Math.min(2, current < 0 ? 0 : current+1) :
                     (current < 0 ? 0 : current);
      placeCard(card, slots[target]);
    }
  });
  card.addEventListener('pointerdown', e => {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    pointerCard = card;
    card.setPointerCapture(e.pointerId);
    card.classList.add('dragging');
  });
  card.addEventListener('pointermove', e => {
    if (pointerCard !== card) return;
    const el = document.elementFromPoint(e.clientX, e.clientY);
    slots.forEach(s => s.classList.toggle('over', !!el && s.contains(el)));
  });
  card.addEventListener('pointerup', e => {
    if (pointerCard !== card) return;
    const el = document.elementFromPoint(e.clientX, e.clientY);
    const target = el && el.closest('.slot');
    if (target) placeCard(card, target);
    card.classList.remove('dragging');
    slots.forEach(s => s.classList.remove('over'));
    pointerCard = null;
  });
  card.addEventListener('pointercancel', () => {
    card.classList.remove('dragging'); slots.forEach(s=>s.classList.remove('over')); pointerCard=null;
  });
  return card;
}
function placeCard(card, slot) {
  const existing = slot.querySelector('.card');
  if (existing && existing !== card) pool.appendChild(existing);
  slot.appendChild(card);
  slot.querySelector('.placeholder')?.remove();
  slots.forEach(s => {
    if (!s.querySelector('.card') && !s.querySelector('.placeholder')) {
      const p = document.createElement('div'); p.className='placeholder'; p.textContent='Drop an image here'; s.appendChild(p);
    }
  });
  selected = null;
  feedback.textContent = '';
  feedback.className = '';
}
function init() {
  pool.innerHTML = '';
  slots.forEach(s => {
    const card = s.querySelector('.card'); if (card) card.remove();
    if (!s.querySelector('.placeholder')) { const p=document.createElement('div'); p.className='placeholder'; p.textContent='Drop an image here'; s.appendChild(p); }
  });
  [0,1,2].forEach(i => pool.appendChild(makeCard(i)));
  feedback.textContent=''; feedback.className='';
}
slots.forEach(slot => {
  slot.addEventListener('click', () => { if (selected) placeCard(selected, slot); });
  slot.addEventListener('keydown', e => { if ((e.key==='Enter'||e.key===' ') && selected) { e.preventDefault(); placeCard(selected,slot); } });
});
document.getElementById('check').addEventListener('click', () => {
  const order = slots.map(s => Number(s.querySelector('.card')?.dataset.index ?? -1));
  if (order.some(i => i < 0)) {
    feedback.className='bad'; feedback.textContent='Please place all three images before checking your answer.'; return;
  }
  if (correctOrder && order.every((v,i)=>v===correctOrder[i])) {
    feedback.className='good'; feedback.textContent='Correct! You put the process steps in the right order.';
  } else if (correctOrder) {
    feedback.className='bad'; feedback.textContent='Not quite. Review the sequence and try again.';
  } else {
    feedback.className='good'; feedback.textContent='All three images are in place. The correct sequence has not been configured yet.';
  }
});
document.getElementById('reset').addEventListener('click', init);
init();
</script>
</body>
</html>
